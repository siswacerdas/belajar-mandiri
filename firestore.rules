rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: cek apakah request dari admin ──
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Helper: cek apakah user sudah approved ──
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // ── Koleksi: users ──
    match /users/{uid} {
      // User bisa baca data dirinya sendiri
      allow read: if request.auth != null && request.auth.uid == uid;

      // Buat dokumen baru (saat daftar) — siapa saja yang terautentikasi
      // tapi hanya untuk UID miliknya sendiri, status harus 'pending', role harus 'user'
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user';

      // Update hanya oleh admin
      allow update: if isAdmin();

      // Delete hanya oleh admin
      allow delete: if isAdmin();

      // Admin bisa baca semua user
      allow read: if isAdmin();
    }

    // ── Admin bisa list (query) seluruh koleksi users ──
    match /users/{uid} {
      allow list: if isAdmin();
    }

    // ── Koleksi: progress kuis ──
    match /users/{uid}/progress/{kuisId} {
      // User hanya bisa baca & tulis progress dirinya sendiri, dan harus approved
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && isApproved();

      // Admin bisa baca semua progress
      allow read: if isAdmin();
    }

  }
}
