rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: cek apakah request dari admin ──────────────────────
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Helper: cek apakah user sudah approved ─────────────────────
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // ── Koleksi: users ─────────────────────────────────────────────
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user';

      allow get:    if isAdmin();
      allow list:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Koleksi: progress kuis (sub-koleksi users) ─────────────────
    match /users/{uid}/progress/{kuisId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && isApproved();

      allow read: if isAdmin();
    }

    // ── Koleksi: hasilKuis (top-level, untuk log & ranking) ────────
    // User approved: bisa buat log miliknya sendiri + baca semua
    // Admin: akses penuh
    match /hasilKuis/{docId} {
      // Buat log — uid di dokumen harus cocok dengan uid login
      allow create: if request.auth != null
        && isApproved()
        && request.resource.data.uid == request.auth.uid;

      // Baca semua (untuk tampilkan ranking ke semua user)
      allow read: if request.auth != null && isApproved();

      // Admin: baca & hapus
      allow read, delete: if isAdmin();
    }

  }
}
