rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: cek apakah request dari admin ──
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Helper: cek apakah user sudah approved ──
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // ── Koleksi: users ──
    match /users/{uid} {
      // User bisa baca dokumen dirinya sendiri
      allow get: if request.auth != null && request.auth.uid == uid;

      // Buat dokumen baru saat daftar — hanya untuk UID sendiri,
      // status wajib 'pending', role wajib 'user'
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user';

      // Admin bisa baca satu dokumen manapun
      allow get: if isAdmin();

      // Admin bisa query/list seluruh koleksi users
      allow list: if isAdmin();

      // Admin bisa update dan delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Koleksi: progress kuis ──
    match /users/{uid}/progress/{kuisId} {
      // User hanya bisa akses progress miliknya sendiri, dan harus approved
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && isApproved();

      // Admin bisa baca semua progress
      allow read: if isAdmin();
    }

  }
}
